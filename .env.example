# Environment configuration
#
# Copy this file to .env.local for machine-local values.
# .env.local is gitignored. Do not commit real credentials.
#
# Server-only variables must not use the NEXT_PUBLIC_ prefix.
# They stay on the server and must not be placed in browser bundles.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle.
# Anyone who loads the site can read them. Never put secrets there.
#
# Schemas:
# - src/lib/env/server.ts
# - src/lib/env/client.ts
#
# PostgreSQL is required for database commands and for running the app
# against a real database. Docker is not required. Point DATABASE_URL at
# a local or hosted PostgreSQL instance.
#
# The value below is a placeholder, not a credential.
# DATABASE_URL is server-only. Do not prefix it with NEXT_PUBLIC_.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# HMAC key for OTP codes. Server-only. Required. Minimum 32 characters.
# Never log this value. Never prefix it with NEXT_PUBLIC_.
# The placeholder below is not a production secret.

OTP_HASH_SECRET=replace-with-at-least-32-random-characters

# Local-only page-preview convenience. Requires NODE_ENV=development and never
# authorizes mutations or creates a session/database identity.
DEV_AUTH_BYPASS=false
# When DEV_AUTH_BYPASS=true, all three resource groups below are required.
# The bypass refuses database/storage access unless the marker is exactly local
# and these point to separately provisioned development resources.
DEV_AUTH_BYPASS_RESOURCE=local
DEV_DATABASE_URL=postgresql://USER:PASSWORD@LOCAL_HOST:5432/VIDORA_DEVELOPMENT
DEV_STORAGE_ENDPOINT=https://storage.example.liara.site
DEV_STORAGE_REGION=default
DEV_STORAGE_BUCKET=vidora-development
DEV_STORAGE_ACCESS_KEY=replace-with-development-access-key
DEV_STORAGE_SECRET_KEY=replace-with-development-secret-key
DEV_STORAGE_FORCE_PATH_STYLE=true

# Optional outside production. Required when NODE_ENV=production.
# Outside production, OTP verification allows http://localhost:3000.
# Set APP_ORIGIN to add another exact origin in development/test, or as
# the sole production origin. Use a canonical absolute origin with no path:
#   https://example.com
#   http://127.0.0.1:3000
# Do not point this at a forwarded host. See instructions/security.md.

# Kavenegar verify/lookup. Server-only. Required only when sending an OTP SMS.
# Not read during build or tests. Never log the API key.
# Template name: English letters and digits, no spaces or underscores.

KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Liara Object Storage (S3-compatible). Server-only.
# Required only when object storage is constructed (not at build/boot).
# Never log these values. Never prefix them with NEXT_PUBLIC_.
# Official Liara Next.js docs use region `default` and forcePathStyle: true.
# Endpoint comes from the bucket SDK settings (e.g. https://storage.c2.liara.site).
# Values below are placeholders, not credentials.

STORAGE_ENDPOINT=https://storage.example.liara.site
STORAGE_REGION=default
STORAGE_BUCKET=example-bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Temporary signed-access TTL (seconds). Server-only.
# Required only when the matching signed-access operation is used:
#   read  → createReadAccess
#   upload → createUploadAccess
# Not required for storage construction or connectivity checks.
# Positive integers only; max 604800 (S3 SigV4 technical bound).
# No product-default TTL is shipped — set explicit values per environment.
# Preview and original remain separately configured policies.

STORAGE_SIGNED_PREVIEW_READ_TTL_SECONDS=
STORAGE_SIGNED_ORIGINAL_READ_TTL_SECONDS=
STORAGE_SIGNED_PREVIEW_UPLOAD_TTL_SECONDS=
STORAGE_SIGNED_ORIGINAL_UPLOAD_TTL_SECONDS=
