// Customer authentication persistence only.
// Internal IDs are PostgreSQL gen_random_uuid() values. They are not customer-facing.
// Administrative identity is deferred. V1 has one administrator, but no approved
// Admin authentication persistence contract exists yet. Do not add a role on User
// to stand in for that contract.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Customer identity. `phone` is the canonical Iranian mobile `+989XXXXXXXXX`.
/// The unique constraint is the identity invariant under concurrent creation.
/// The format CHECK is in the `init_auth_core` migration: Prisma schema cannot
/// represent CHECK constraints.
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique @db.VarChar(13)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
}

/// An OTP challenge may exist before the customer User row does, so this model
/// has no user foreign key. `codeHash` is an HMAC-SHA256 digest, never the
/// plaintext OTP. `sentAt` stays null while the row is only reserved. An
/// unexpired reserved row blocks older challenges for the same phone. A
/// non-null `sentAt` records that the SMS provider accepted this send. A
/// non-null `consumedAt` records successful use and invalidates the challenge.
/// It is not set when verification attempts are exhausted. A non-null
/// `supersededAt` records that a newer OTP for the same phone was successfully
/// sent. Neither timestamp means the other, and `expiresAt` stays the original
/// lifetime. `failedAttemptCount` starts at 0. The 5th wrong code stores 5 and
/// that count makes the challenge permanently unusable. Eligibility is
/// `instructions/security.md`. `@@index([phone, createdAt])` supports lookup
/// of a phone's challenges in creation order. Lifetime, resend cooldown, and
/// the verification attempt limit are policy in `instructions/security.md`,
/// not columns here.
model OtpChallenge {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone              String    @db.VarChar(13)
  codeHash           String
  expiresAt          DateTime  @db.Timestamptz(3)
  failedAttemptCount Int       @default(0)
  consumedAt         DateTime? @db.Timestamptz(3)
  sentAt             DateTime? @db.Timestamptz(3)
  supersededAt       DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
}

/// One OTP send attempt that passed cooldown and hourly-limit checks.
/// Phone and IP limits count these rows so the limits hold across application
/// instances. The row stays if SMS sending fails. The reserved `OtpChallenge`
/// is removed only while `sentAt` is null, so a failed send does not start the
/// resend cooldown. A delivered challenge is not deleted.
/// `clientIp` is the bounded address from the request boundary, not a forwarded
/// header. There is no user foreign key. The phone CHECK is in the migration
/// SQL because Prisma schema cannot represent CHECK constraints.
model OtpRequestEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @db.VarChar(13)
  clientIp  String   @db.VarChar(45)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([clientIp, createdAt])
}

/// Server-side customer session. `secretHash` is the SHA-256 hex digest of the
/// cookie token. The raw token is not stored. Lookup uses that unique hash.
/// `expiresAt` is 30 days after creation and is not extended on use.
/// Explicit revocation is not part of the approved session model.
/// `onDelete: Cascade` removes sessions with their user. A session has no
/// meaning without that user, and sessions are not purchase or invoice history.
model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  secretHash String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}
