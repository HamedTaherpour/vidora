// Customer and Admin authentication persistence.
// Internal IDs are PostgreSQL gen_random_uuid() values. They are not public
// account identifiers. Customer identity is the canonical phone on User.
// Admin identity is a separate Admin row with its own phone and sessions.
// Do not add a role on User. Do not model Admin as a special Customer.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Distinguishes customer and admin OTP challenges that share one table.
/// A customer challenge must not authenticate Admin, and vice versa.
enum OtpPurpose {
  customer
  admin
}

/// Customer identity. `phone` is the canonical Iranian mobile `+989XXXXXXXXX`.
/// The unique constraint is the identity invariant under concurrent creation.
/// The format CHECK is in the `init_auth_core` migration: Prisma schema cannot
/// represent CHECK constraints.
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique @db.VarChar(13)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
}

/// An OTP challenge may exist before the customer User row does, so this model
/// has no user foreign key. Admin challenges also have no admin foreign key;
/// Admin must already be provisioned before verification succeeds.
/// `purpose` separates customer and admin authentication contexts that share
/// this table. Cooldown, supersession, and active selection are scoped by
/// phone + purpose. Hourly request limits still count by phone and IP across
/// purposes because SMS cost is shared.
/// `codeHash` is an HMAC-SHA256 digest, never the plaintext OTP. `sentAt`
/// stays null while the row is only reserved. An unexpired reserved row blocks
/// older challenges for the same phone and purpose. A non-null `sentAt`
/// records that the SMS provider accepted this send. A non-null `consumedAt`
/// records successful use and invalidates the challenge. It is not set when
/// verification attempts are exhausted. A non-null `supersededAt` records that
/// a newer OTP for the same phone and purpose was successfully sent. Neither
/// timestamp means the other, and `expiresAt` stays the original lifetime.
/// `failedAttemptCount` starts at 0. The 5th wrong code stores 5 and that
/// count makes the challenge permanently unusable. Eligibility is
/// `instructions/security.md`. `@@index([phone, purpose, createdAt])` supports
/// lookup of a phone's challenges for one purpose in creation order. Lifetime,
/// resend cooldown, and the verification attempt limit are policy in
/// `instructions/security.md`, not columns here.
model OtpChallenge {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone              String     @db.VarChar(13)
  purpose            OtpPurpose @default(customer)
  codeHash           String
  expiresAt          DateTime   @db.Timestamptz(3)
  failedAttemptCount Int        @default(0)
  consumedAt         DateTime?  @db.Timestamptz(3)
  sentAt             DateTime?  @db.Timestamptz(3)
  supersededAt       DateTime?  @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
}

/// One OTP send attempt that passed cooldown and hourly-limit checks.
/// Phone and IP limits count these rows so the limits hold across application
/// instances. Limits are shared across OTP purposes for the same phone because
/// SMS cost is shared. The row stays if SMS sending fails. The reserved
/// `OtpChallenge` is removed only while `sentAt` is null, so a failed send does
/// not start the resend cooldown. A delivered challenge is not deleted.
/// `clientIp` is the bounded address from the request boundary, not a forwarded
/// header. There is no user foreign key. The phone CHECK is in the migration
/// SQL because Prisma schema cannot represent CHECK constraints.
model OtpRequestEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @db.VarChar(13)
  clientIp  String   @db.VarChar(45)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@index([clientIp, createdAt])
}

/// Server-side customer session. `secretHash` is the SHA-256 hex digest of the
/// cookie token. The raw token is not stored. Lookup uses that unique hash.
/// `expiresAt` is 30 days after creation and is not extended on use.
/// Explicit revocation is not part of the approved session model.
/// `onDelete: Cascade` removes sessions with their user. A session has no
/// meaning without that user, and sessions are not purchase or invoice history.
model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  secretHash String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
}

/// Administrator identity. Separate from Customer `User`. The same canonical
/// phone may exist independently on User and Admin. Phone uniqueness is only
/// within Admin. No public signup. Rows are provisioned manually.
/// The format CHECK is in the migration SQL.
model Admin {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique @db.VarChar(13)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  sessions AdminSession[]
}

/// Server-side Admin session. Separate from customer `Session`.
/// Cookie is `vidora_admin_session`. Lookup uses the unique `secretHash`.
/// `onDelete: Cascade` removes sessions with their Admin. Cascade is storage
/// cleanup, not an approved Admin deletion product policy.
model AdminSession {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @db.Uuid
  secretHash String   @unique
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([adminId])
}

/// V1 publication lifecycle for Footage. Speculative states such as ARCHIVED
/// or SCHEDULED are not part of the approved product model.
enum FootageStatus {
  DRAFT
  PUBLISHED
}

/// Flat V1 catalog Category. No parentId, hierarchy, or taxonomy groups.
/// `nameFa` is the Persian display name. `slug` is the unique durable lookup
/// key. Automatic slug generation and slug-history/redirect tables are not
/// part of this model.
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameFa    String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  footage Footage[]
}

/// V1 catalog Tag. Many Footage items may share a Tag, and one Footage may
/// have many Tags through `FootageTag`. No tag groups or localization tables.
/// `nameFa` is the Persian display name. `slug` is the unique durable lookup
/// key. Automatic slug generation is not part of this model.
model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameFa    String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  footageTags FootageTag[]
}

/// Explicit Footage ↔ Tag join. Composite primary key prevents duplicate
/// relationships. No extra join metadata in V1. Cascade on Footage or Tag
/// delete removes only join rows, not the other catalog entity.
model FootageTag {
  footageId String @db.Uuid
  tagId     String @db.Uuid

  footage Footage @relation(fields: [footageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([footageId, tagId])
  @@index([tagId])
}

/// Purchasable catalog Footage metadata. Media files, search, and commerce
/// relations belong to later tasks. Each Footage belongs to exactly one
/// Category. Tags are many-to-many through `FootageTag`.
/// `titleFa` and `descriptionFa` are Persian storefront content. Do not add
/// speculative English/locale fields here.
/// `priceToman` is integer Toman. Floating-point money is forbidden. The
/// non-negative CHECK and published-state CHECK live in the migration SQL
/// because Prisma schema cannot represent CHECK constraints.
/// `publishedAt` is null for DRAFT and required for PUBLISHED. That pairing is
/// the durable publication contract; scheduled publishing is not supported.
/// `@@index([status])` supports the known published-footage storefront listing.
/// `@@index([categoryId])` supports listing Footage in one Category.
/// Category deletion uses Restrict so referenced Footage is not silently
/// deleted.
model Footage {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleFa       String        @db.VarChar(200)
  slug          String        @unique @db.VarChar(120)
  descriptionFa String
  priceToman    Int
  status        FootageStatus @default(DRAFT)
  categoryId    String        @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  publishedAt   DateTime?     @db.Timestamptz(3)

  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  footageTags FootageTag[]

  @@index([status])
  @@index([categoryId])
}
